# Capstone service settings (all optional; defaults in support_agent/config.py)
SUPPORT_MODEL_PROVIDER=bedrock
SUPPORT_MODEL_ID=us.amazon.nova-pro-v1:0
SUPPORT_FALLBACK_MODEL_ID=
SUPPORT_AWS_REGION=us-east-1
SUPPORT_TEMPERATURE=0.2
SUPPORT_MAX_TOKENS=2048

SUPPORT_GUARDRAIL_ID=
SUPPORT_GUARDRAIL_VERSION=

SUPPORT_REFUND_AUTO_APPROVE_LIMIT=50
SUPPORT_REFUND_HARD_LIMIT=500

SUPPORT_MAX_TURNS=8
SUPPORT_MAX_TOTAL_TOKENS=40000
SUPPORT_DEADLINE_SECONDS=60

# Empty bucket = local files in SUPPORT_SESSION_DIR
SUPPORT_SESSION_BUCKET=
SUPPORT_SESSION_PREFIX=support-sessions/
SUPPORT_SESSION_DIR=./sessions

SUPPORT_JSON_LOGS=true
SUPPORT_LOG_LEVEL=INFO

# Tracing (lesson 17)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental,gen_ai_unredacted_attributes=
