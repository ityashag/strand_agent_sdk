# Copy this file to .env and fill it in:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# ---- Which model to use -----------------------------------------------------------
# bedrock | openai | anthropic | ollama | fake
#   fake  = offline scripted model, no key needed (good for a first look and for tests)
MODEL_PROVIDER=fake

# Model ID for that provider. Examples:
#   bedrock   : us.amazon.nova-pro-v1:0   (empty = Strands' default Bedrock model)
#   openai    : gpt-4o
#   anthropic : claude-sonnet-4-5
#   ollama    : qwen3:8b   (run `ollama pull qwen3:8b` first)
MODEL_ID=

# A cheaper, faster model for helpers (summaries, judges, routing). Optional.
SMALL_MODEL_ID=

# ---- Sampling ---------------------------------------------------------------------
# Leave TEMPERATURE empty to not send it (some reasoning models reject it).
# For tool-using agents a low value (0 - 0.3) gives more consistent tool choices.
TEMPERATURE=
MAX_TOKENS=4096

# ---- AWS / Bedrock ----------------------------------------------------------------
# Uses your normal AWS credentials (aws configure / aws sso login / AWS_PROFILE).
AWS_REGION=us-east-1
# Optional Bedrock guardrail (lesson 16)
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ---- Provider API keys (read directly by the provider SDKs) ------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Network behaviour of the model client ----------------------------------------
CONNECT_TIMEOUT=10
READ_TIMEOUT=120
CLIENT_MAX_RETRIES=2

# ---- Ollama -----------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434

# ---- Logging ----------------------------------------------------------------------
LOG_LEVEL=INFO
